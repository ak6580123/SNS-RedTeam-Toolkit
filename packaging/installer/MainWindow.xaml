<Window x:Class="ScripterSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scripter Setup" Width="640" Height="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource Bg}"
        Icon="pack://application:,,,/icon.ico">
    <Border BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- custom title bar -->
            <Grid Grid.Row="0" Background="{StaticResource Panel}" MouseLeftButtonDown="Drag">
                <TextBlock x:Name="TitleBar" Text="Scripter Setup" Margin="14,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/>
                <Button Content="&#x2715;" HorizontalAlignment="Right" Width="46" Padding="0" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource Muted}" Click="CloseClick"/>
            </Grid>

            <Grid Grid.Row="1" Margin="32,24,32,24">
                <!-- header -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <Image Source="pack://application:,,,/logo.png" Width="64" Height="64"/>
                    <StackPanel Margin="16,2,0,0">
                        <TextBlock x:Name="Heading" Text="Scripter" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" Foreground="{StaticResource Accent}" FontSize="13" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Subtitle" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                                   Text="Authorized red-team automation for A/D CTF and cyber ranges"/>
                    </StackPanel>
                </StackPanel>

                <!-- page 1: options -->
                <StackPanel x:Name="PageOptions" Margin="0,92,0,0">
                    <TextBlock x:Name="ExistingNote" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock Text="Install location" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="DirBox"/>
                        <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="BrowseClick"/>
                    </Grid>
                    <TextBlock Text="Installs for the current user only - no administrator rights needed." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,14"/>
                    <CheckBox x:Name="PathCheck" Content="Add Scripter to my PATH (use 'scripter' from any terminal)" IsChecked="True"/>
                    <CheckBox x:Name="MenuCheck" Content="Create a Start Menu shortcut" IsChecked="True"/>
                    <CheckBox x:Name="DesktopCheck" Content="Create a Desktop shortcut"/>
                </StackPanel>

                <!-- page 2: progress -->
                <StackPanel x:Name="PageProgress" Margin="0,130,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="StatusText" Text="Preparing..." FontSize="14" Margin="0,0,0,12"/>
                    <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="0"/>
                    <TextBlock x:Name="Percent" Text="0%" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- page 3: done -->
                <StackPanel x:Name="PageDone" Margin="0,110,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="DoneTitle" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                    <TextBlock x:Name="DoneText" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,18" TextWrapping="Wrap"/>
                    <CheckBox x:Name="LaunchCheck" Content="Launch Scripter now" IsChecked="True"/>
                </StackPanel>

                <!-- uninstall options -->
                <StackPanel x:Name="PageUninstall" Margin="0,110,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="UninstallText" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <CheckBox x:Name="WorkspaceCheck" Content="Also delete my workspace (config, database, reports)"/>
                </StackPanel>

                <!-- buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button x:Name="CancelBtn" Content="Cancel" Margin="0,0,10,0" Click="CloseClick"/>
                    <Button x:Name="MainBtn" Content="Install" Style="{StaticResource Primary}" MinWidth="110" Click="MainClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
